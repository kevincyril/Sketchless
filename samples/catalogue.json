    {
      "id": "cleaner",
      "name": "Robot vacuum",
      "description": "A round home-cleaner concept with wheels, sensors and brush.",
      "spec": {
        "part_type": "assembly",
        "schema_version": 1,
        "units": "mm",
        "coordinates": "right-handed-z-up-xyz-degrees",
        "name": "Home cleaner - robot vacuum",
        "concept": "cleaner",
        "assumptions": [
          "Interpreted home cleaner as a low round robot vacuum: 340 mm body diameter, 75 mm body height; brush and sensor may extend beyond the shell.",
