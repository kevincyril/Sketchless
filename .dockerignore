# Deny everything, then include only build inputs. Local keys/data never enter the context.
**
!Dockerfile
!requirements.txt
!backend/
!backend/*.py
!ml/
!ml/__init__.py
!ml/model.py
!ml/classifier.joblib
!ml/config.json
!ml/dataset.json
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.js
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!deploy/
!deploy/start.py
# Keep secret-like files excluded even inside otherwise allowed directories.
.env
**/.env
**/.env.*
**/*.pem
**/*.key
**/__pycache__/**

!frontend/gallery.html
!frontend/scripts/
!frontend/scripts/**
!examples/
!examples/spec.json
!examples/inspection.json
!examples/part.step
!examples/part.stl
!examples/bracket/
!examples/bracket/*
!examples/table/
!examples/table/*
!examples/robot/
!examples/robot/*
!examples/cleaner/
!examples/cleaner/*
# Reapply secret exclusions after all allow rules.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.sqlite3
**/*.zip
