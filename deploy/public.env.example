# Public HTTPS deployment only. Store the real Gemini key separately as a backend secret.
SKETCHLESS_DEPLOYMENT_MODE=public
SKETCHLESS_PUBLIC_MODE=true
SKETCHLESS_PUBLIC_ORIGIN=https://replace-with-your-host.example
SKETCHLESS_DATA_DIR=/app/data
# Set true only after a persistent local disk/volume is mounted and tested.
SKETCHLESS_PERSISTENT_STORAGE_CONFIRMED=false
DEMO_MODE=true
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MODEL=gemini-3.5-flash-lite
SKETCHLESS_AI_DAILY_LIMIT=20
SKETCHLESS_AI_VISITOR_DAILY_LIMIT=5
SKETCHLESS_AI_NETWORK_MINUTE_LIMIT=3
SKETCHLESS_AI_QUOTA_COOLDOWN_SECONDS=300
SKETCHLESS_MAX_DATA_MB=512
